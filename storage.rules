rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN','ADMIN','MANAGER']; }
    match /public/{allPaths=**} { allow read: if true; allow write: if isAdmin(); }
    match /clients/{uid}/{allPaths=**} { allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid); }
    match /projects/{projectId}/{allPaths=**} { allow read, write: if isAdmin(); }
  }
}
